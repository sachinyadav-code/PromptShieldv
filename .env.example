# ==============================================================================
# PromptShield Enterprise LLM Security Gateway - Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env for local development or define these variables
#    in your deployment orchestrator (Docker, Kubernetes, systemd, etc.).
# 2. DO NOT commit actual secrets or production credentials to source control.
# 3. All placeholder values below are NON-PRODUCTION DEMONSTRATIONS ONLY.
#    You MUST generate cryptographically secure, high-entropy keys before deploying.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GATEWAY AUTHENTICATION
# ------------------------------------------------------------------------------
# PROMPTSHIELD_AUTH_ENABLED:
#   Controls gateway API key authentication enforcement.
#   - Defaults to 'true' (fail-closed secure default).
#   - Accepted truthy values: any value not in ('false', '0', 'no', 'disabled').
#   - Set explicitly to 'false', '0', 'no', or 'disabled' ONLY for local development or testing.
#   - When enabled, requests to sensitive endpoints (/inspect, /proxy, /audit/*, /rag/*)
#     require a valid API key via 'Authorization: Bearer <key>' or 'X-API-Key: <key>'.
#   - The public health check endpoint (/health) is always exempt from authentication.
PROMPTSHIELD_AUTH_ENABLED=true

# PROMPTSHIELD_API_KEYS:
#   Comma- or whitespace-separated list of authorized API keys for gateway clients.
#   - Splitting rules: parsed with regex r'[\s,]+'; both commas and whitespace
#     (spaces, tabs, newlines) act as token delimiters. Surrounding whitespace is stripped.
#   - Fail-closed behavior: When authentication is enabled and this variable is unset
#     or empty, ALL requests to protected endpoints are rejected with HTTP 401 Unauthorized.
#   - Constant-time validation: Keys are compared using secrets.compare_digest.
#   - CRITICAL WARNING:
#     THE VALUE BELOW IS A NON-PRODUCTION PLACEHOLDER. IT MUST NEVER BE DEPLOYED.
#     Generate production keys using a CSPRNG, for example:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
PROMPTSHIELD_API_KEYS=replace-with-a-secure-random-key-do-not-use-in-production

# ------------------------------------------------------------------------------
# 2. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# PROMPTSHIELD_ALLOWED_ORIGINS:
#   Comma-separated list of allowed browser origins permitted to make cross-origin requests.
#   - Default: empty string (same-origin only; no cross-origin browser access permitted).
#   - Splitting rules: comma-separated; each origin is whitespace-trimmed.
#   - IMPORTANT SECURITY NOTICE:
#     CORS is strictly a browser-enforced security mechanism governing cross-origin
#     web application access. CORS IS NOT API AUTHENTICATION AND DOES NOT PROTECT
#     AGAINST NON-BROWSER CLIENTS (e.g., curl, scripts, backend services, or attackers).
#   - For local development with the Vite dashboard, use:
#     http://localhost:5173,http://127.0.0.1:5173
#   - For production, set this to the exact HTTPS origin of your deployed dashboard UI.
PROMPTSHIELD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. RATE LIMITING & CONCURRENCY CONTROL
# ------------------------------------------------------------------------------
# PROMPTSHIELD_RATE_LIMIT_ENABLED:
#   Enables in-memory sliding-window rate limiting per authenticated caller identity.
#   - Default: true.
#   - Accepted truthy: 'true', '1', 'yes', 'enabled'.
#   - Accepted falsy:  'false', '0', 'no', 'disabled'.
#   - Any other non-empty string raises ValueError at startup (fails closed).
PROMPTSHIELD_RATE_LIMIT_ENABLED=true

# PROMPTSHIELD_RATE_LIMIT_REQUESTS:
#   Maximum requests allowed within the sliding window per caller identity.
#   - Default: 100 requests.
#   - Validation bounds: positive integer; enforced maximum upper limit is 10000.
#   - Values <= 0 or > 10000 raise ValueError.
PROMPTSHIELD_RATE_LIMIT_REQUESTS=100

# PROMPTSHIELD_RATE_LIMIT_WINDOW_SECONDS:
#   Sliding window duration in seconds.
#   - Default: 60 seconds.
#   - Validation bounds: positive integer; enforced maximum upper limit is 86400 (24 hours).
#   - Values <= 0 or > 86400 raise ValueError.
PROMPTSHIELD_RATE_LIMIT_WINDOW_SECONDS=60

# PROMPTSHIELD_MAX_CONCURRENT_REQUESTS:
#   Maximum concurrent in-flight requests processed simultaneously across expensive
#   endpoints (/inspect, /proxy, /rag/*) to prevent worker thread / heap exhaustion.
#   - Default: 20 concurrent requests.
#   - Validation bounds: positive integer; enforced maximum upper limit is 1000.
#   - Values <= 0 or > 1000 raise ValueError.
#   - When exhausted, callers receive HTTP 503 Service Unavailable with a Retry-After header.
PROMPTSHIELD_MAX_CONCURRENT_REQUESTS=20

# ------------------------------------------------------------------------------
# 4. ML ENFORCEMENT POLICY
# ------------------------------------------------------------------------------
# PROMPTSHIELD_ML_ENFORCEMENT_MODE:
#   Enforcement mode for the scikit-learn prompt injection detection model.
#   - Precedence: Programmatic override -> PROMPTSHIELD_ML_ENFORCEMENT_MODE
#                 -> ML_ENFORCEMENT_MODE (fallback) -> default ('observe').
#   - Supported values (case-sensitive):
#       'observe'            : Score and log risk; does not block based on ML score (default).
#       'block_on_threshold' : Block requests (HTTP 403 / BLOCKED) if ML score >= threshold.
#   - Any other value raises ValueError at startup.
PROMPTSHIELD_ML_ENFORCEMENT_MODE=observe

# ------------------------------------------------------------------------------
# 5. PERSISTENT AUDIT LOGGING
# ------------------------------------------------------------------------------
# PROMPTSHIELD_AUDIT_DB_PATH:
#   Filesystem path to the persistent SQLite audit database file.
#   - Default: 'audit.db' (resolved relative to the current working directory).
#   - The audit store initializes the database in WAL mode with busy_timeout=5000ms.
#   - For containerized deployments, set this to a path residing on a persistent volume
#     (e.g., '/data/audit.db') so audit logs persist across container recreations.
PROMPTSHIELD_AUDIT_DB_PATH=audit.db

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT CONFIGURATION (Optional - for Vite frontend build / runtime)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL:
#   Base URL of the PromptShield backend gateway consumed by the React dashboard client.
#   - Default fallback: 'http://127.0.0.1:8000' (used if unset or empty).
#   - Trailing slashes are automatically stripped by the frontend client.
#   - Set this when deploying the frontend to point to the reachable gateway host.
VITE_API_BASE_URL=http://127.0.0.1:8000